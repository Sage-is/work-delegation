#!/usr/bin/env bash
# oc-edit — delegate a file edit to opencode's CLI.
# Usage: oc-edit <dir> <model> "<instruction>" [files...]
#        oc-edit --doctor            (verify PATH, skill, hook, env, ledger, lock)
#        oc-edit --unlock [--force]  (report the lock; release it when stale)
# Env: OC_DELEGATE=0 disables delegation entirely (exit 3).
#      OC_LOG=<path> moves the prompt ledger; OC_LOG=0 disables it.
#      Default ledger: ~/.local/state/oc-edit/log.jsonl, one JSON line per run.
#      OC_BRIEF_MAX=<n> raises the hard brief ceiling (default 3500 chars).
#      OC_NO_INDEX_ADD=1 skips `git add -N` on newly created files.
# Exit: 1 opencode failure, 2 usage, 3 disabled, 4 hardlink refusal,
#       5 silent no-op, 6 stall (2 timeouts), 7 lock busy, 8 brief too long,
#       9 wedged (ran past its own ceiling with no session and no diff).
#      Exit 9 is evidence against this wrapper, not against the model — do not
#      re-route away from a model that returned it.
# Creating files: name the new path as a trailing arg and it is seeded as an
# empty file (parents created) so opencode's -f attaches; or just say "create
# <path>" in the brief and let the delegate write it. Either way the new file
# is untracked, so `git diff` alone would show nothing — on success oc-edit
# `git add -N`s every file that appeared during the run, making creations
# visible to the reviewer's diff. Empty seeds are always removed again.
set -euo pipefail

# GNU coreutils timeout is required: this wrapper needs -k (SIGKILL after
# SIGTERM) and needs timeout's process-group signalling. macOS ships no timeout
# in the base system; Homebrew's coreutils installs it under both names.
TIMEOUT_BIN=$(command -v timeout || command -v gtimeout || true)

# Gateway stall watchdog: the opencode gateway intermittently queues a request
# forever (per-model congestion). Cap each attempt, pause, retry once, then
# fail fast with exit 6 so the caller can fall back to another model or inline.
OC_TIMEOUT=${OC_TIMEOUT:-120}
OC_KILL_AFTER=${OC_KILL_AFTER:-10}

LOCK="${OC_LOCK:-/tmp/oc-edit-$(id -u).lock}"
OC_LOCK_WAIT=${OC_LOCK_WAIT:-90}
# Longest a run can legitimately hold the lock: two capped attempts, the 15s
# pause between them, and slack for the git and fingerprint work either side.
OC_LOCK_MAX_AGE=${OC_LOCK_MAX_AGE:-$(( 2 * (OC_TIMEOUT + OC_KILL_AFTER) + 60 ))}

# Epoch mtime of a path: BSD stat (macOS) then GNU stat (Linux).
mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# Stale means the holder is gone, or the lock is older than any run can
# legitimately take. That single test covers all three ways a lock outlives its
# owner: a dead holder, a holder that died before writing its pid at all (empty
# pid file, which the old liveness-only check skipped and then waited out), and
# a live holder that has wedged. mkdir stamps the directory mtime at creation,
# so the age is readable from the instant the lock exists — nothing may write
# into the lock dir after acquire, or the refreshed mtime disables this.
lock_is_stale() {
  local pid; pid=$(cat "$1/pid" 2>/dev/null || true)
  [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null && return 0
  [ "$(( $(date +%s) - $(mtime_of "$1") ))" -ge "$OC_LOCK_MAX_AGE" ]
}

# Reclaim by rename, never by removal in place. mv is atomic and the source
# vanishes, so of two waiters that both judge a lock stale exactly one wins and
# the loser falls back to retrying mkdir. Removing in place lets both win and
# run unserialized — the very hazard the lock exists to prevent. Re-testing the
# captured directory covers the gap where the holder released and a fresh run
# acquired in between: that lock is young, so it goes back untouched.
reclaim_lock() {                         # $1: --force to skip the staleness re-test
  local victim="$LOCK.stale.$$"
  rm -rf "$victim"                       # mv onto an existing dir nests inside it
  mv "$LOCK" "$victim" 2>/dev/null || return 1
  if [ "${1:-}" != --force ] && ! lock_is_stale "$victim"; then
    mv "$victim" "$LOCK" 2>/dev/null
    return 1
  fi
  lock_reclaimed=$(cat "$victim/pid" 2>/dev/null || echo unknown)
  rm -rf "$victim"
  echo "oc-edit: reclaimed stale lock from pid $lock_reclaimed" >&2
}

# Self-check: is this machine fully wired for delegation?
if [ "${1:-}" = "--doctor" ]; then
  status=0
  pass() { echo "PASS  $1"; }
  fail() { echo "FAIL  $1"; status=1; }
  command -v opencode >/dev/null 2>&1 && pass "opencode on PATH" || fail "opencode on PATH"
  [ -n "$TIMEOUT_BIN" ] && pass "GNU timeout on PATH ($TIMEOUT_BIN)" \
    || fail "GNU timeout on PATH (brew install coreutils)"
  command -v oc-edit >/dev/null 2>&1 && pass "oc-edit on PATH" || fail "oc-edit on PATH (run: make install)"
  [ -f "$HOME/.claude/skills/delegate-edit/SKILL.md" ] \
    && pass "delegate-edit skill installed" || fail "delegate-edit skill installed (run: make install)"
  grep -q oc-delegate-hook "$HOME/.claude/settings.json" 2>/dev/null \
    && pass "enforce hook registered in ~/.claude/settings.json" \
    || fail "enforce hook registered in ~/.claude/settings.json"
  [ "${OC_DELEGATE:-1}" != "0" ] \
    && pass "delegation armed (OC_DELEGATE unset or 1)" \
    || fail "delegation armed (kill switch OC_DELEGATE=0 is set)"
  if [ "${OC_DELEGATE_ENFORCE:-0}" = "1" ]; then
    pass "enforcement on (OC_DELEGATE_ENFORCE=1)"
  else
    echo "note  enforcement off (OC_DELEGATE_ENFORCE unset) — hook stays inert"
  fi
  log=${OC_LOG:-$HOME/.local/state/oc-edit/log.jsonl}
  if [ "$log" = "0" ]; then
    echo "note  ledger disabled (OC_LOG=0)"
  elif mkdir -p "$(dirname "$log")" 2>/dev/null && [ -w "$(dirname "$log")" ]; then
    pass "ledger writable: $log"
  else
    fail "ledger writable: $log"
  fi
  # A held lock takes every delegation on the machine down, so surface it here
  # rather than letting the next run discover it as exit 7.
  if [ ! -d "$LOCK" ]; then
    pass "delegation lock free ($LOCK)"
  elif lock_is_stale "$LOCK"; then
    fail "stale lock at $LOCK held by pid $(cat "$LOCK/pid" 2>/dev/null || echo unknown) — run: oc-edit --unlock"
  else
    echo "note  lock held by pid $(cat "$LOCK/pid" 2>/dev/null || echo unknown), age $(( $(date +%s) - $(mtime_of "$LOCK") ))s — a delegation is running"
  fi
  # Brief economy: delegation only pays when the brief is far smaller than the
  # artifact. Rising brief sizes mean the expensive model is typing again.
  if [ "$log" != "0" ] && [ -s "$log" ]; then
    OC_D_LOG=$log OC_D_CAP=$OC_LOCK_MAX_AGE python3 - <<'PY2' || status=1
import json, os, statistics
rows = []
for line in open(os.environ["OC_D_LOG"], encoding="utf-8", errors="replace"):
    try:
        rows.append(json.loads(line))
    except Exception:
        pass
rows = rows[-50:]
if not rows:
    raise SystemExit
# Implausible durations: a run past the wrapper's own ceiling with nothing to
# show for it was a wedge, not a model result, and routing decisions are read
# from these rows. Three such rows exist (2026-08-19 and two on 2026-08-21),
# all logged rc=0. Scanned over the same recent window as the brief economy
# below, so a fixed wedge ages out instead of failing the doctor forever.
cap = int(os.environ["OC_D_CAP"])
wedges = [r for r in rows
          if (r.get("duration_s") or 0) > cap
          and not (r.get("session") and r.get("diff_stat"))]
if wedges:
    worst = max(wedges, key=lambda r: r["duration_s"])
    print(f"FAIL  {len(wedges)} implausible run(s) in the last {len(rows)} — longest "
          f"{worst['duration_s']}s at {worst['ts']}, logged rc={worst.get('rc')} "
          f"with no session and no diff")
    print("      those rows are wrapper wedges, not model results; do not route on them")
else:
    print(f"PASS  no implausible durations in the last {len(rows)} runs")
briefs = [r.get("brief_chars") or len(r.get("instruction", "")) for r in rows]
med = int(statistics.median(briefs))
over = sum(1 for b in briefs if b > 2000)
refused = sum(1 for r in rows if r.get("rc") == 8)
created = sum(len(r.get("created") or []) for r in rows)
verdict = "PASS  " if med <= 2000 else "note  "
print(f"{verdict}brief economy: median {med} chars over last {len(rows)} runs "
      f"({over} over 2000, {refused} refused, {created} file(s) created)")
if med > 2000:
    print("      briefs are trending toward dictation — state outcomes and "
          "point at reference files instead of inlining them")
raise SystemExit(1 if wedges else 0)
PY2
  fi
  exit "$status"
fi

# Inspect the machine-wide delegation lock, and release it when it is stale.
# This signals nothing, ever: freeing the mutex is a directory removal, while
# deciding that a process should die is a human's call with this report in
# hand. It prints rather than writing to the ledger — the reclaims worth
# keeping as evidence are the automatic ones, which ride on their own run's row.
if [ "${1:-}" = "--unlock" ]; then
  if [ ! -d "$LOCK" ]; then
    echo "no lock at $LOCK"
    exit 0
  fi
  echo "lock    $LOCK"
  echo "holder  $(cat "$LOCK/pid" 2>/dev/null || echo "<none recorded>")"
  echo "age     $(( $(date +%s) - $(mtime_of "$LOCK") ))s (ceiling ${OC_LOCK_MAX_AGE}s)"
  if [ "${2:-}" != "--force" ] && ! lock_is_stale "$LOCK"; then
    echo "held    the holder looks healthy; wait for it, or force with: oc-edit --unlock --force" >&2
    exit 7
  fi
  reclaim_lock "${2:-}" || { echo "held    another process reclaimed or replaced it first" >&2; exit 0; }
  exit 0
fi

if [ "${OC_DELEGATE:-1}" = "0" ]; then
  echo "oc-edit: delegation disabled (OC_DELEGATE=0)" >&2
  exit 3
fi

if [ $# -lt 3 ]; then
  echo "usage: oc-edit <dir> <model> \"<instruction>\" [files...]" >&2
  exit 2
fi

dir=$1; model=$2; instruction=$3; shift 3

if [ ! -d "$dir" ]; then
  echo "oc-edit: no such directory: $dir" >&2
  exit 2
fi

if [ -z "$TIMEOUT_BIN" ]; then
  echo "oc-edit: no GNU timeout on PATH — install coreutils (brew install coreutils)" >&2
  exit 2
fi

# Brief-economy nudge: multi-KB briefs correlate with gateway stalls
# (docs/stall-investigation.md) and cancel the token savings. Warn, never block.
# Ceiling from the ledger (20 runs, 2026-08-18): every brief >=3992 chars
# failed (3 stalls, 1 error); every brief <=2904 succeeded. 3500 sits in that
# gap — it refuses what has never worked and permits what always has.
OC_BRIEF_MAX=${OC_BRIEF_MAX:-3500}
if [ "${#instruction}" -gt "$OC_BRIEF_MAX" ]; then
  echo "oc-edit: REFUSED — brief is ${#instruction} chars (ceiling $OC_BRIEF_MAX). A brief this long is dictation, not delegation: the expensive model already typed the artifact as a prose spec, and briefs this size are the measured stall signature (docs/stall-investigation.md). Cut it to outcomes, invariants, and pointers to reference files in $dir. Raise OC_BRIEF_MAX only with a reason." >&2
  exit 8
fi
if [ "${#instruction}" -gt 2000 ]; then
  echo "oc-edit: WARNING — brief is ${#instruction} chars; multi-KB briefs correlate with gateway stalls and cancel the savings. Trim, split, or point the delegate at reference files in $dir instead of inlining." >&2
fi
# Dictation shape: fenced blocks are for invariants, not for pasting the
# artifact. A brief carrying dozens of fenced lines has stopped delegating.
fenced=$(printf '%s\n' "$instruction" | awk '/^ *```/{f=!f; next} f{n++} END{print n+0}')
if [ "$fenced" -gt 30 ]; then
  echo "oc-edit: WARNING — brief contains $fenced lines inside code fences. That is the artifact, not a spec. Keep fenced content to verbatim invariants and let the delegate write the rest." >&2
fi

# Prompt ledger: one JSON line per run, written from the EXIT trap so
# refusals, stalls, and silent no-ops are captured alongside successes.
OC_LOG=${OC_LOG:-$HOME/.local/state/oc-edit/log.jsonl}
start_ts=$(date +%s)
session=""; retries=0; diff_stat=""; lock_held=""; paths=(); seeded=(); created=""
untracked_before=""; out_file=""; lock_reclaimed=""; wedged=""
log_event() {
  [ "$OC_LOG" = "0" ] && return 0
  mkdir -p "$(dirname "$OC_LOG")" 2>/dev/null || return 0
  OC_L_RC=$1 OC_L_DIR=$dir OC_L_MODEL=$model OC_L_INSTRUCTION=$instruction \
  OC_L_FILES=$(printf '%s\n' ${paths[@]+"${paths[@]}"}) \
  OC_L_SEEDED=$(printf '%s\n' ${seeded[@]+"${seeded[@]}"}) OC_L_CREATED=$created \
  OC_L_SESSION=$session OC_L_RETRIES=$retries \
  OC_L_DURATION=$(( $(date +%s) - start_ts )) OC_L_DIFF_STAT=$diff_stat \
  OC_L_WEDGED=$wedged OC_L_RECLAIMED=$lock_reclaimed \
  python3 - >> "$OC_LOG" 2>/dev/null <<'PY' || true
import json, os, time
e = os.environ
print(json.dumps({
    "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "dir": e["OC_L_DIR"],
    "model": e["OC_L_MODEL"],
    "files": [f for f in e["OC_L_FILES"].splitlines() if f],
    "seeded": [f for f in e["OC_L_SEEDED"].splitlines() if f],
    "created": [f for f in e["OC_L_CREATED"].splitlines() if f],
    "instruction": e["OC_L_INSTRUCTION"],
    "brief_chars": len(e["OC_L_INSTRUCTION"]),
    "preamble": "v1",
    "rc": int(e["OC_L_RC"]),
    "session": e["OC_L_SESSION"] or None,
    "retries": int(e["OC_L_RETRIES"]),
    "duration_s": int(e["OC_L_DURATION"]),
    "diff_stat": e["OC_L_DIFF_STAT"] or None,
    # The exit code the body reached before the wedge check overrode it, or
    # None when the run finished inside its ceiling.
    "wedged": int(e["OC_L_WEDGED"]) if e["OC_L_WEDGED"] else None,
    "lock_reclaimed": e["OC_L_RECLAIMED"] or None,
}, ensure_ascii=False))
PY
}
cleanup() {
  rc=$?
  # A wedge that logs rc=0 corrupts the routing evidence: ledger 2026-08-21T10:30
  # records rc=0 at duration_s=66905, an 18.6-hour hang filed as a clean win.
  # Past the wrapper's own ceiling with neither a session nor a diff to show for
  # it, the run was wedged, whatever exit status the body reached. A run that
  # produced both did the work however long it took and keeps its rc; both
  # observed wedges had neither.
  duration=$(( $(date +%s) - start_ts ))
  if [ "$duration" -gt "$OC_LOCK_MAX_AGE" ] && { [ -z "$session" ] || [ -z "$diff_stat" ]; }; then
    echo "oc-edit: WEDGED — ${duration}s against a ${OC_TIMEOUT}s cap, with no session or no diff (body exited $rc)" >&2
    wedged=$rc; rc=9
  fi
  if [ "$rc" -ne 0 ]; then
    # A failed run must not leave seed stubs behind; keep any the model filled.
    for f in ${seeded[@]+"${seeded[@]}"}; do
      [ -s "$f" ] || rm -f "$f"
    done
  fi
  [ -n "$out_file" ] && rm -f "$out_file"
  [ -n "$lock_held" ] && rm -rf "$LOCK"
  log_event "$rc" || true
  exit "$rc"
}
trap cleanup EXIT

# A retired model reaches the gateway as a stall, not an error: the same model
# gave rc=6 at 256s on one run and rc=1 at 2s on the next (ledger 2026-08-21),
# so the stall path hides what is really a config error. Ask the provider first
# and fail fast. An empty listing means the check itself failed (offline,
# unknown provider) — never block a run on an answer we could not get.
avail=$("$TIMEOUT_BIN" 15 opencode models "${model%%/*}" 2>/dev/null || true)
if [ -n "$avail" ] && ! printf '%s\n' "$avail" | grep -qx "$model"; then
  echo "oc-edit: no such model: $model — ${model%%/*} offers:" >&2
  printf '%s\n' "$avail" | sed 's/^/  /' >&2
  exit 2
fi

# Snapshot untracked paths BEFORE seeding, so both seeds and files the delegate
# invents on its own register as creations after the run.
untracked_before=$( cd "$dir" && git ls-files --others --exclude-standard 2>/dev/null | sort || true )

# Hardlink guard: opencode's editor replaces inodes; refuse hardlinked targets.
file_args=()
for f in "$@"; do
  case $f in
    /*) path=$f ;;
    *)  path="$dir/$f" ;;
  esac
  paths+=("$path")
  if [ -e "$path" ]; then
    links=$(stat -f %l "$path")
    if [ "$links" -gt 1 ]; then
      echo "oc-edit: REFUSED — $path has $links hardlinks; editing breaks the chain" >&2
      exit 4
    fi
  else
    # Seed create-new targets: opencode's -f refuses nonexistent files.
    mkdir -p "$(dirname "$path")"
    : > "$path"
    seeded+=("$path")
    echo "oc-edit: seeded new file $path"
  fi
  file_args+=(-f "$path")
done

# Deny git and destructive commands at the permission layer; --auto approves the rest.
# Rule order matters: LAST matching rule wins, so "*":"allow" goes first.
export OPENCODE_PERMISSION='{
  "bash": {
    "*": "allow",
    "git*": "deny",
    "rm -rf*": "deny",
    "opencode*": "deny"
  },
  "edit": "allow",
  "webfetch": "deny",
  "websearch": "deny"
}'

preamble="You are performing a single scoped file edit or file creation. Do NOT run any \
git commands (no add/commit/push/checkout). Do NOT touch files other than those named. \
Make only the requested change, matching the surrounding style exactly. \
If a named file is empty or missing, it is a new file: write its complete contents \
from scratch. Never leave a named file empty."

# One delegation at a time, machine-wide. Phase 1 (2026-08-16,
# docs/stall-investigation.md) never reproduced a stall without multiple live
# instances, so serialization is the no-regrets guard. mkdir is atomic; macOS
# has no flock. A stale holder's lock is reclaimed; a working one is respected.
waited=0; tries=0
until mkdir "$LOCK" 2>/dev/null; do
  # Capped: an unremovable lock dir (root-owned, from one sudo run) would
  # otherwise spin here forever and never reach the exit-7 path below.
  if [ "$tries" -lt 5 ] && lock_is_stale "$LOCK"; then
    tries=$(( tries + 1 )); reclaim_lock || true; continue
  fi
  if [ "$waited" -ge "$OC_LOCK_WAIT" ]; then
    echo "oc-edit: another delegation holds the lock (pid $(cat "$LOCK/pid" 2>/dev/null || echo unknown)) after ${waited}s; inspect it with 'oc-edit --unlock', or edit inline" >&2
    exit 7
  fi
  sleep 2; waited=$((waited + 2))
done
lock_held=1
printf '%s\n' $$ > "$LOCK/pid"

# Fingerprint worktree content (tracked diff + hash of untracked/modified files)
# so edits to not-yet-tracked files are not misread as silent no-ops.
# The group reads from /dev/null so nothing inside it can ever block on the
# wrapper's own stdin. Argless `shasum` did exactly that: with no seeded files
# it took no arguments, fell back to reading stdin, and waited there for an EOF
# that never came. That is the real shape of the long hangs — 2026-08-19 at 12
# minutes, 2026-08-21 at 18.6 and 19.2 hours — every one of which logged
# retries=0 and no session, because the run never reached opencode at all.
fingerprint() (
  cd "$dir" || return 0
  {
    git diff 2>/dev/null
    git ls-files -om --exclude-standard -z 2>/dev/null \
      | xargs -0 shasum -a 256 2>/dev/null
    # Seeded targets explicitly: a new file under .gitignore never shows up in
    # ls-files, and would otherwise be misread as a silent no-op.
    [ "${#seeded[@]}" -gt 0 ] && shasum -a 256 "${seeded[@]}" 2>/dev/null
  } < /dev/null | shasum -a 256 || true
)
before=$(fingerprint)

# --pure skips external plugins: the antigravity auth plugin rewrites its
# state file on every non-pure bootstrap (T3: 5/5), and every model family
# delegation routes to works without it (free, opencode-go, github-copilot).
#
# Never capture this with $(...). Command substitution holds the stdout pipe
# open until EVERY descendant closes it, so one surviving grandchild blocks the
# wrapper long past the cap: measured, a 1s cap took 4s with a backgrounded
# grandchild, and the same command redirected to a file returned in 0s. -k then
# sends SIGKILL after SIGTERM — without it timeout waits forever on a child that
# ignores SIGTERM, which is the 18.6h wedge of 2026-08-20.
out_file=$(mktemp "${TMPDIR:-/tmp}/oc-edit-out.XXXXXX")
run_once() {
  "$TIMEOUT_BIN" -k "$OC_KILL_AFTER" "$OC_TIMEOUT" opencode run "$preamble

$instruction" --dir "$dir" -m "$model" --auto --format json --pure ${file_args[@]+"${file_args[@]}"} > "$out_file" 2>&1
}
# 124 when SIGTERM ended the child, 137 when the -k SIGKILL had to: timeout
# signals its own process group, so it dies of its own SIGKILL and reports
# 128+9. Both mean capped, and 137 must not fall through to the failure path.
is_capped() { [ "$1" -eq 124 ] || [ "$1" -eq 137 ]; }

rc=0; run_once || rc=$?
out=$(cat "$out_file")
if is_capped "$rc"; then
  echo "oc-edit: no response in ${OC_TIMEOUT}s (rc $rc); retrying once after 15s pause" >&2
  sleep 15
  retries=1
  rc=0; run_once || rc=$?
  out=$(cat "$out_file")
  if is_capped "$rc"; then
    echo "oc-edit: gateway stall on $model (2 attempts); pick another model or edit inline" >&2
    exit 6
  fi
fi
if [ "$rc" -ne 0 ]; then
  echo "oc-edit: opencode run failed" >&2
  printf '%s\n' "$out" | tail -20 >&2
  exit 1
fi

session=$(printf '%s' "$out" | grep -o '"sessionID":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
echo "session: ${session:-unknown}"

# Sweep build artifacts the model may leave from verifying its own edit.
find "$dir" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

# Drop seeds the delegate never filled, before anything else reads the tree.
for f in ${seeded[@]+"${seeded[@]}"}; do
  if [ -e "$f" ] && [ ! -s "$f" ]; then
    rm -f "$f"
    echo "oc-edit: removed unfilled seed $f" >&2
  fi
done

if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  after=$(fingerprint)
  if [ "$before" = "$after" ]; then
    echo "oc-edit: WARNING — no changes detected (silent no-op)" >&2
    exit 5
  fi
  # Files that appeared during the run are untracked, and `git diff` ignores
  # untracked files — a created file would review as an empty diff. Record each
  # one with intent-to-add so the creation shows up in the reviewer's diff.
  untracked_after=$( cd "$dir" && git ls-files --others --exclude-standard 2>/dev/null | sort || true )
  created=$(comm -13 <(printf '%s\n' "$untracked_before") <(printf '%s\n' "$untracked_after") || true)
  if [ -n "$created" ]; then
    echo "--- created ---"
    printf '%s\n' "$created"
    if [ "${OC_NO_INDEX_ADD:-0}" = "1" ]; then
      echo "oc-edit: note — new files left untracked (OC_NO_INDEX_ADD=1); review them with cat, not git diff" >&2
    else
      printf '%s\n' "$created" | ( cd "$dir" && xargs -I{} git add -N -- {} ) 2>/dev/null || true
      echo "oc-edit: note — intent-to-add recorded so \`git diff\` shows the new files; undo with: git -C $dir reset -- $(printf '%s ' $created)"
    fi
  fi
  echo "--- diff stat ---"
  stat_out=$(git -C "$dir" diff --stat)
  printf '%s\n' "$stat_out"
  diff_stat=$(printf '%s\n' "$stat_out" | tail -1 | sed 's/^ *//')
else
  echo "oc-edit: note — $dir is not a git repo; cannot show diff" >&2
  for f in ${seeded[@]+"${seeded[@]}"}; do
    [ -s "$f" ] && echo "oc-edit: created $f"
  done
fi
