#!/usr/bin/env bash
# oc-edit — delegate a file edit to opencode's CLI.
# Usage: oc-edit <dir> <model> "<instruction>" [files...]
#        oc-edit --doctor   (verify PATH, skill, hook, env, ledger)
# Env: OC_DELEGATE=0 disables delegation entirely (exit 3).
#      OC_LOG=<path> moves the prompt ledger; OC_LOG=0 disables it.
#      Default ledger: ~/.local/state/oc-edit/log.jsonl, one JSON line per run.
#      OC_BRIEF_MAX=<n> raises the hard brief ceiling (default 3500 chars).
#      OC_NO_INDEX_ADD=1 skips `git add -N` on newly created files.
# Exit: 1 opencode failure, 2 usage, 3 disabled, 4 hardlink refusal,
#       5 silent no-op, 6 stall (2 timeouts), 7 lock busy, 8 brief too long.
# Creating files: name the new path as a trailing arg and it is seeded as an
# empty file (parents created) so opencode's -f attaches; or just say "create
# <path>" in the brief and let the delegate write it. Either way the new file
# is untracked, so `git diff` alone would show nothing — on success oc-edit
# `git add -N`s every file that appeared during the run, making creations
# visible to the reviewer's diff. Empty seeds are always removed again.
set -euo pipefail

# Self-check: is this machine fully wired for delegation?
if [ "${1:-}" = "--doctor" ]; then
  status=0
  pass() { echo "PASS  $1"; }
  fail() { echo "FAIL  $1"; status=1; }
  command -v opencode >/dev/null 2>&1 && pass "opencode on PATH" || fail "opencode on PATH"
  command -v oc-edit >/dev/null 2>&1 && pass "oc-edit on PATH" || fail "oc-edit on PATH (run: make install)"
  [ -f "$HOME/.claude/skills/delegate-edit/SKILL.md" ] \
    && pass "delegate-edit skill installed" || fail "delegate-edit skill installed (run: make install)"
  grep -q oc-delegate-hook "$HOME/.claude/settings.json" 2>/dev/null \
    && pass "enforce hook registered in ~/.claude/settings.json" \
    || fail "enforce hook registered in ~/.claude/settings.json"
  [ "${OC_DELEGATE:-1}" != "0" ] \
    && pass "delegation armed (OC_DELEGATE unset or 1)" \
    || fail "delegation armed (kill switch OC_DELEGATE=0 is set)"
  if [ "${OC_DELEGATE_ENFORCE:-0}" = "1" ]; then
    pass "enforcement on (OC_DELEGATE_ENFORCE=1)"
  else
    echo "note  enforcement off (OC_DELEGATE_ENFORCE unset) — hook stays inert"
  fi
  log=${OC_LOG:-$HOME/.local/state/oc-edit/log.jsonl}
  if [ "$log" = "0" ]; then
    echo "note  ledger disabled (OC_LOG=0)"
  elif mkdir -p "$(dirname "$log")" 2>/dev/null && [ -w "$(dirname "$log")" ]; then
    pass "ledger writable: $log"
  else
    fail "ledger writable: $log"
  fi
  # Brief economy: delegation only pays when the brief is far smaller than the
  # artifact. Rising brief sizes mean the expensive model is typing again.
  if [ "$log" != "0" ] && [ -s "$log" ]; then
    OC_D_LOG=$log python3 - <<'PY2' || true
import json, os, statistics
rows = []
for line in open(os.environ["OC_D_LOG"], encoding="utf-8", errors="replace"):
    try:
        rows.append(json.loads(line))
    except Exception:
        pass
rows = rows[-50:]
if not rows:
    raise SystemExit
briefs = [r.get("brief_chars") or len(r.get("instruction", "")) for r in rows]
med = int(statistics.median(briefs))
over = sum(1 for b in briefs if b > 2000)
refused = sum(1 for r in rows if r.get("rc") == 8)
created = sum(len(r.get("created") or []) for r in rows)
verdict = "PASS  " if med <= 2000 else "note  "
print(f"{verdict}brief economy: median {med} chars over last {len(rows)} runs "
      f"({over} over 2000, {refused} refused, {created} file(s) created)")
if med > 2000:
    print("      briefs are trending toward dictation — state outcomes and "
          "point at reference files instead of inlining them")
PY2
  fi
  exit "$status"
fi

if [ "${OC_DELEGATE:-1}" = "0" ]; then
  echo "oc-edit: delegation disabled (OC_DELEGATE=0)" >&2
  exit 3
fi

if [ $# -lt 3 ]; then
  echo "usage: oc-edit <dir> <model> \"<instruction>\" [files...]" >&2
  exit 2
fi

dir=$1; model=$2; instruction=$3; shift 3

if [ ! -d "$dir" ]; then
  echo "oc-edit: no such directory: $dir" >&2
  exit 2
fi

# Brief-economy nudge: multi-KB briefs correlate with gateway stalls
# (docs/stall-investigation.md) and cancel the token savings. Warn, never block.
# Ceiling from the ledger (20 runs, 2026-08-18): every brief >=3992 chars
# failed (3 stalls, 1 error); every brief <=2904 succeeded. 3500 sits in that
# gap — it refuses what has never worked and permits what always has.
OC_BRIEF_MAX=${OC_BRIEF_MAX:-3500}
if [ "${#instruction}" -gt "$OC_BRIEF_MAX" ]; then
  echo "oc-edit: REFUSED — brief is ${#instruction} chars (ceiling $OC_BRIEF_MAX). A brief this long is dictation, not delegation: the expensive model already typed the artifact as a prose spec, and briefs this size are the measured stall signature (docs/stall-investigation.md). Cut it to outcomes, invariants, and pointers to reference files in $dir. Raise OC_BRIEF_MAX only with a reason." >&2
  exit 8
fi
if [ "${#instruction}" -gt 2000 ]; then
  echo "oc-edit: WARNING — brief is ${#instruction} chars; multi-KB briefs correlate with gateway stalls and cancel the savings. Trim, split, or point the delegate at reference files in $dir instead of inlining." >&2
fi
# Dictation shape: fenced blocks are for invariants, not for pasting the
# artifact. A brief carrying dozens of fenced lines has stopped delegating.
fenced=$(printf '%s\n' "$instruction" | awk '/^ *```/{f=!f; next} f{n++} END{print n+0}')
if [ "$fenced" -gt 30 ]; then
  echo "oc-edit: WARNING — brief contains $fenced lines inside code fences. That is the artifact, not a spec. Keep fenced content to verbatim invariants and let the delegate write the rest." >&2
fi

# Prompt ledger: one JSON line per run, written from the EXIT trap so
# refusals, stalls, and silent no-ops are captured alongside successes.
OC_LOG=${OC_LOG:-$HOME/.local/state/oc-edit/log.jsonl}
start_ts=$(date +%s)
session=""; retries=0; diff_stat=""; lock_held=""; paths=(); seeded=(); created=""
untracked_before=""
log_event() {
  [ "$OC_LOG" = "0" ] && return 0
  mkdir -p "$(dirname "$OC_LOG")" 2>/dev/null || return 0
  OC_L_RC=$1 OC_L_DIR=$dir OC_L_MODEL=$model OC_L_INSTRUCTION=$instruction \
  OC_L_FILES=$(printf '%s\n' ${paths[@]+"${paths[@]}"}) \
  OC_L_SEEDED=$(printf '%s\n' ${seeded[@]+"${seeded[@]}"}) OC_L_CREATED=$created \
  OC_L_SESSION=$session OC_L_RETRIES=$retries \
  OC_L_DURATION=$(( $(date +%s) - start_ts )) OC_L_DIFF_STAT=$diff_stat \
  python3 - >> "$OC_LOG" 2>/dev/null <<'PY' || true
import json, os, time
e = os.environ
print(json.dumps({
    "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "dir": e["OC_L_DIR"],
    "model": e["OC_L_MODEL"],
    "files": [f for f in e["OC_L_FILES"].splitlines() if f],
    "seeded": [f for f in e["OC_L_SEEDED"].splitlines() if f],
    "created": [f for f in e["OC_L_CREATED"].splitlines() if f],
    "instruction": e["OC_L_INSTRUCTION"],
    "brief_chars": len(e["OC_L_INSTRUCTION"]),
    "preamble": "v1",
    "rc": int(e["OC_L_RC"]),
    "session": e["OC_L_SESSION"] or None,
    "retries": int(e["OC_L_RETRIES"]),
    "duration_s": int(e["OC_L_DURATION"]),
    "diff_stat": e["OC_L_DIFF_STAT"] or None,
}, ensure_ascii=False))
PY
}
cleanup() {
  rc=$?
  if [ "$rc" -ne 0 ]; then
    # A failed run must not leave seed stubs behind; keep any the model filled.
    for f in ${seeded[@]+"${seeded[@]}"}; do
      [ -s "$f" ] || rm -f "$f"
    done
  fi
  [ -n "$lock_held" ] && rm -rf "$LOCK"
  log_event "$rc" || true
  exit "$rc"
}
trap cleanup EXIT

# Snapshot untracked paths BEFORE seeding, so both seeds and files the delegate
# invents on its own register as creations after the run.
untracked_before=$( cd "$dir" && git ls-files --others --exclude-standard 2>/dev/null | sort || true )

# Hardlink guard: opencode's editor replaces inodes; refuse hardlinked targets.
file_args=()
for f in "$@"; do
  case $f in
    /*) path=$f ;;
    *)  path="$dir/$f" ;;
  esac
  paths+=("$path")
  if [ -e "$path" ]; then
    links=$(stat -f %l "$path")
    if [ "$links" -gt 1 ]; then
      echo "oc-edit: REFUSED — $path has $links hardlinks; editing breaks the chain" >&2
      exit 4
    fi
  else
    # Seed create-new targets: opencode's -f refuses nonexistent files.
    mkdir -p "$(dirname "$path")"
    : > "$path"
    seeded+=("$path")
    echo "oc-edit: seeded new file $path"
  fi
  file_args+=(-f "$path")
done

# Deny git and destructive commands at the permission layer; --auto approves the rest.
# Rule order matters: LAST matching rule wins, so "*":"allow" goes first.
export OPENCODE_PERMISSION='{
  "bash": {
    "*": "allow",
    "git*": "deny",
    "rm -rf*": "deny",
    "opencode*": "deny"
  },
  "edit": "allow",
  "webfetch": "deny",
  "websearch": "deny"
}'

preamble="You are performing a single scoped file edit or file creation. Do NOT run any \
git commands (no add/commit/push/checkout). Do NOT touch files other than those named. \
Make only the requested change, matching the surrounding style exactly. \
If a named file is empty or missing, it is a new file: write its complete contents \
from scratch. Never leave a named file empty."

# One delegation at a time, machine-wide. Phase 1 (2026-08-16,
# docs/stall-investigation.md) never reproduced a stall without multiple live
# instances, so serialization is the no-regrets guard. mkdir is atomic; macOS
# has no flock. A dead holder's lock is reclaimed; a live one is respected.
LOCK="${OC_LOCK:-/tmp/oc-edit-$(id -u).lock}"
waited=0
until mkdir "$LOCK" 2>/dev/null; do
  holder=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
    rm -rf "$LOCK" 2>/dev/null || true
    continue
  fi
  if [ "$waited" -ge "${OC_LOCK_WAIT:-90}" ]; then
    echo "oc-edit: another delegation holds the lock (pid ${holder:-unknown}) after ${waited}s; retry later or edit inline" >&2
    exit 7
  fi
  sleep 2; waited=$((waited + 2))
done
lock_held=1
printf '%s\n' $$ > "$LOCK/pid"

# Fingerprint worktree content (tracked diff + hash of untracked/modified files)
# so edits to not-yet-tracked files are not misread as silent no-ops.
fingerprint() (
  cd "$dir" || return 0
  {
    git diff 2>/dev/null
    git ls-files -om --exclude-standard -z 2>/dev/null \
      | xargs -0 shasum -a 256 2>/dev/null
    # Seeded targets explicitly: a new file under .gitignore never shows up in
    # ls-files, and would otherwise be misread as a silent no-op.
    shasum -a 256 ${seeded[@]+"${seeded[@]}"} 2>/dev/null
  } | shasum -a 256 || true
)
before=$(fingerprint)

# Gateway stall watchdog: the opencode gateway intermittently queues a request
# forever (per-model congestion). Cap each attempt, pause, retry once, then
# fail fast with exit 6 so the caller can fall back to another model or inline.
OC_TIMEOUT=${OC_TIMEOUT:-120}
# --pure skips external plugins: the antigravity auth plugin rewrites its
# state file on every non-pure bootstrap (T3: 5/5), and every model family
# delegation routes to works without it (free, opencode-go, github-copilot).
run_once() {
  timeout "$OC_TIMEOUT" opencode run "$preamble

$instruction" --dir "$dir" -m "$model" --auto --format json --pure ${file_args[@]+"${file_args[@]}"} 2>&1
}
rc=0; out=$(run_once) || rc=$?
if [ "$rc" -eq 124 ]; then
  echo "oc-edit: no response in ${OC_TIMEOUT}s; retrying once after 15s pause" >&2
  sleep 15
  retries=1
  rc=0; out=$(run_once) || rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "oc-edit: gateway stall on $model (2 attempts); pick another model or edit inline" >&2
    exit 6
  fi
fi
if [ "$rc" -ne 0 ]; then
  echo "oc-edit: opencode run failed" >&2
  printf '%s\n' "$out" | tail -20 >&2
  exit 1
fi

session=$(printf '%s' "$out" | grep -o '"sessionID":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
echo "session: ${session:-unknown}"

# Sweep build artifacts the model may leave from verifying its own edit.
find "$dir" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

# Drop seeds the delegate never filled, before anything else reads the tree.
for f in ${seeded[@]+"${seeded[@]}"}; do
  if [ -e "$f" ] && [ ! -s "$f" ]; then
    rm -f "$f"
    echo "oc-edit: removed unfilled seed $f" >&2
  fi
done

if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  after=$(fingerprint)
  if [ "$before" = "$after" ]; then
    echo "oc-edit: WARNING — no changes detected (silent no-op)" >&2
    exit 5
  fi
  # Files that appeared during the run are untracked, and `git diff` ignores
  # untracked files — a created file would review as an empty diff. Record each
  # one with intent-to-add so the creation shows up in the reviewer's diff.
  untracked_after=$( cd "$dir" && git ls-files --others --exclude-standard 2>/dev/null | sort || true )
  created=$(comm -13 <(printf '%s\n' "$untracked_before") <(printf '%s\n' "$untracked_after") || true)
  if [ -n "$created" ]; then
    echo "--- created ---"
    printf '%s\n' "$created"
    if [ "${OC_NO_INDEX_ADD:-0}" = "1" ]; then
      echo "oc-edit: note — new files left untracked (OC_NO_INDEX_ADD=1); review them with cat, not git diff" >&2
    else
      printf '%s\n' "$created" | ( cd "$dir" && xargs -I{} git add -N -- {} ) 2>/dev/null || true
      echo "oc-edit: note — intent-to-add recorded so \`git diff\` shows the new files; undo with: git -C $dir reset -- $(printf '%s ' $created)"
    fi
  fi
  echo "--- diff stat ---"
  stat_out=$(git -C "$dir" diff --stat)
  printf '%s\n' "$stat_out"
  diff_stat=$(printf '%s\n' "$stat_out" | tail -1 | sed 's/^ *//')
else
  echo "oc-edit: note — $dir is not a git repo; cannot show diff" >&2
  for f in ${seeded[@]+"${seeded[@]}"}; do
    [ -s "$f" ] && echo "oc-edit: created $f"
  done
fi
